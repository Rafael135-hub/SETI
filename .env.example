# URL-encode special characters in the password. Keep the real value in .env.local.
DATABASE_URL=postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_URL_ENCODED_PASSWORD]@aws-[REGION].pooler.supabase.com:6543/postgres
# If the direct connection fails on your local network or hosting provider,
# use the Shared Pooler transaction-mode string from the Supabase Connect dialog instead.
# Example:
# DATABASE_URL=postgres://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-[REGION].pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_SPEAKERS=seti-speakers
SUPABASE_STORAGE_BUCKET_CRITERIA=seti-criteria
SUPABASE_STORAGE_BUCKET_CONTACTS=seti-contacts
SUPABASE_STORAGE_BUCKET_CLASSES=seti-classes
